<Project>
    <PropertyGroup>
        <!-- Point this at a Shoko checkout to build against its projects, the
             analyzer included, instead of the packages below. -->
        <ShokoRepositoryPath Condition="'$(ShokoRepositoryPath)' == ''"></ShokoRepositoryPath>

        <!-- Used only without a checkout. -->
        <ShokoAbstractionsVersion>6.0.0-alpha.114</ShokoAbstractionsVersion>

        <!-- A solution build otherwise builds TMDbLib, which it does not list,
             as Debug. -->
        <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
    </PropertyGroup>
</Project>
